MULTIVERSE_DB=/var/lib/multiverse/multiverse.db
MULTIVERSE_WORK_ROOT=/var/lib/multiverse/work
MULTIVERSE_RUNNER_IMAGE=registry.example/multiverse-runner@sha256:replace-with-published-digest
MULTIVERSE_OPENSHELL_SETUP_POLICY_PYTHON=/opt/multiverse/deploy/openshell/setup-python-policy.yaml
MULTIVERSE_OPENSHELL_SETUP_POLICY_NODE=/opt/multiverse/deploy/openshell/setup-node-policy.yaml
MULTIVERSE_OPENSHELL_SETUP_POLICY_RUST=/opt/multiverse/deploy/openshell/setup-rust-policy.yaml
MULTIVERSE_OPENSHELL_RUN_POLICY=/opt/multiverse/deploy/openshell/run-policy.yaml
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL_LIGHTNING=nvidia/Nemotron-3_5-Lightning
NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
# Add NEBIUS_API_KEY through the host secret manager, not this file in source control.
